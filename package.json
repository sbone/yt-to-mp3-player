{
  "name": "yt-to-audio-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "npm run build:css && tsc -p tsconfig.json",
    "build:css": "tailwindcss -i ./src/web/static/input.css -o ./dist/public/app.css --minify",
    "check": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
