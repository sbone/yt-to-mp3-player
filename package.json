{
  "name": "yt-to-audio-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:server": "./scripts/dev-server.sh",
    "dev:client": "/opt/homebrew/bin/asdf exec node ./node_modules/vite/bin/vite.js",
    "build": "./scripts/build.sh",
    "build:client": "/opt/homebrew/bin/asdf exec node ./node_modules/vite/bin/vite.js build",
    "build:server": "/opt/homebrew/bin/asdf exec node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "check": "./scripts/check.sh",
    "test:smoke": "/opt/homebrew/bin/asdf exec node ./node_modules/playwright/cli.js test",
    "doctor": "./scripts/doctor.sh",
    "reconcile:device": "./scripts/reconcile-device.sh",
    "rebuild:native": "./scripts/rebuild-native.sh",
    "start": "./scripts/start.sh"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "express": "^4.21.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^8.0.12"
  }
}
