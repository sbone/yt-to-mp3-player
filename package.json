{
  "name": "local-audio-device-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:server": "./scripts/dev-server.sh",
    "build": "./scripts/build.sh",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.json",
    "check": "./scripts/check.sh",
    "test": "npm run test:unit && npm run test:smoke",
    "test:unit": "playwright test --config playwright.unit.config.ts",
    "test:smoke": "playwright test",
    "test:production": "PLAYWRIGHT_PRODUCTION=1 playwright test",
    "screenshots": "PLAYWRIGHT_SCREENSHOTS=1 playwright test tests/screenshots.spec.ts",
    "demo": "DEMO_MODE=1 ./scripts/dev.sh",
    "doctor": "./scripts/doctor.sh",
    "reconcile:device": "./scripts/reconcile-device.sh",
    "rebuild:native": "./scripts/rebuild-native.sh",
    "start": "./scripts/start.sh"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@webtui/css": "0.1.10",
    "better-sqlite3": "11.8.1",
    "express": "4.22.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "4.17.21",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.15",
    "typescript": "5.8.2",
    "vite": "8.3.2"
  }
}
